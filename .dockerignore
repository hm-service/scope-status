# 约定：本地 / 临时目录一律以 . 开头（.github/ 是唯一例外，它是真正的源码）
#
# 注意：这里排掉的路径若被 go:embed 引用（例如 docs/），镜像里就会缺文件、编译失败，
#       到时候把对应行删掉。

# 版本控制与仓库元数据
/.git/
/.github/
/.gitignore
/.dockerignore

# 构建产物（just build 的输出都在 .dist/；不进构建上下文）
/.dist/

# Go 缓存：默认在 $HOME，$HOME 只读时由 justfile 重定向到这里
/.go-build/
/.gopath/
/.go-mod-cache/

# 前端包管理器的缓存
/.npm-cache/
/.pnpm-store/

# 运行时数据（DATA_DIR），首次启动自动重建
/.data/
/.data_sample/

# 前端：依赖与构建产物都在镜像里自己生成，宿主机的这两份不进上下文
# （frontend/ 的源码要进 —— 前端阶段得靠它构建）
/frontend/node_modules/
/frontend/dist/

# 参考项目 / 概念验证 / 验证截图
/.ref/
/.scratch/
/.shots/

# 换实现语言时归档的旧版本
/.prototype/

# agent / 编辑器 / 语言运行时自带的目录
/.agents/
/.claude/
/.codex/
/.venv/
/.uv-cache/

# 环境变量与日志
/.env
/.env.*
*.log

# 构建镜像用不到的文档与部署描述
/docs/
/README.md
/DESIGN.md
/AGENTS.md
/k8s.yaml
/quadlet-kube.kube
/justfile
